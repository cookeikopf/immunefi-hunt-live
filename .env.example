# ── Pflicht in Produktion ────────────────────────────────────────────
# Geheimnis für JWT-Signaturen — mindestens 32 zufällige Zeichen!
# Erzeugen z. B. mit:  python -c "import secrets; print(secrets.token_urlsafe(48))"
KMUOS_SECRET_KEY=

# ── KI (Anthropic Claude) ────────────────────────────────────────────
# Erforderlich für Firmen-Assistent, KI-Insights, KI-Builder, Wochenbericht.
# Ohne Schlüssel laufen alle Module, RAG-Suche, Automationen & Workflows trotzdem.
ANTHROPIC_API_KEY=

# ── Optionale Einstellungen (Präfix KMUOS_) ──────────────────────────
# SaaS-Modus: dürfen sich neue Firmen selbst registrieren? (Self-Hosted: false)
KMUOS_ALLOW_SIGNUP=false

# Datenbank: SQLite (Standard) oder PostgreSQL
KMUOS_DATABASE_URL=sqlite:///./kmuos.db
# KMUOS_DATABASE_URL=postgresql+psycopg2://kmuos:passwort@postgres:5432/kmuos
# POSTGRES_PASSWORD=   # nur für docker compose --profile postgres

# Claude-Modell und Token-Limit
KMUOS_ANTHROPIC_MODEL=claude-opus-4-8
KMUOS_AI_MAX_TOKENS=16000

# Zeitgesteuerte Automationen (bei Scale-out nur auf 1 Instanz aktiv lassen)
KMUOS_SCHEDULER_ENABLED=true
