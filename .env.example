# Anthropic API-Schlüssel — erforderlich für KI-Chat & KI-Insights.
# Ohne Schlüssel laufen alle Module und die RAG-Suche trotzdem.
ANTHROPIC_API_KEY=

# Optionale Einstellungen (Präfix KMUOS_)
KMUOS_COMPANY_NAME=Musterfirma GmbH
KMUOS_DATABASE_URL=sqlite:///./kmuos.db
KMUOS_ANTHROPIC_MODEL=claude-opus-4-8
